build/
build-*/
cmake-build-*/
.cache/
.codex
.codex/
.venv/
.vscode/
compile_commands.json

# Python cache
__pycache__/
*.py[cod]

# Large data / generated artifacts
artifacts/
benchmarks/
data/
deepvbscf_data/
deepvbscf_data_f2_scan/
tmp_compare/

